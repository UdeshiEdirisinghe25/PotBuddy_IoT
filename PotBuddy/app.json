{
  "expo": {
    "name": "PotBuddy",
    "slug": "potbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "potbuddy",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.potbuddy.mobile"
    },
    "android": {
      "package": "com.potbuddy.mobile",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "alerts",
          "color": "#216b4a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "web": {
      "favicon": "./public/favicon.ico"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "apiPort": null,
      "eas": {
        "projectId": "f69779cb-a80a-4606-94df-326bb49e00f5"
      }
    }
  }
}