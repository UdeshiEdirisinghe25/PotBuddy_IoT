{
  "expo": {
    "name": "PotBuddy",
    "slug": "potbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "potbuddy",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.potbuddy.mobile"
    },
    "android": {
      "package": "com.potbuddy.mobile",
      "permissions": []
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "alerts",
          "color": "#216b4a"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "apiPort": null,
      "eas": {
        "projectId": "f69779cb-a80a-4606-94df-326bb49e00f5"
      }
    }
  }
}
